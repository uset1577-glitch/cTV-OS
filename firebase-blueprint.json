{
  "entities": {
    "LauncherStatus": {
      "title": "Launcher Status",
      "description": "Global maintenance and Apps-Only mode configuration",
      "type": "object",
      "properties": {
        "maintenanceMode": {
          "type": "boolean",
          "description": "Whether global maintenance mode is active"
        },
        "appsOnlyMode": {
          "type": "boolean",
          "description": "Whether global Apps-Only mode is active"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Maintenance notice title"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Maintenance notice message"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated server timestamp"
        }
      },
      "required": ["maintenanceMode", "appsOnlyMode", "title", "message", "updatedAt"]
    }
  },
  "firestore": {
    "/launcherStatus/{statusId}": {
      "schema": {
        "$ref": "LauncherStatus"
      },
      "description": "Global launcher status documents (only global is writable by verified admin)"
    }
  }
}
