<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:endColor="#1A2232"
                android:startColor="#0A0D12"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="168dp">
        <shape android:shape="rectangle">
            <solid android:color="#F59E0B" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="72dp"
        android:width="72dp">
        <shape android:shape="oval">
            <solid android:color="#F59E0B" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="32dp"
        android:width="32dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#0A0D12" />
        </shape>
    </item>
</layer-list>
